# Firebase Configuration — Copy this to .env and fill in your real values
# NEVER commit the actual .env file
# Vite automatically injects VITE_ prefixed variables at build time

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=profusebeauty-682fb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=profusebeauty-682fb
VITE_FIREBASE_STORAGE_BUCKET=profusebeauty-682fb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Payfast — store these in Firebase Cloud Secret Manager, NEVER in .env or source code:
#   firebase functions:secrets:set PAYFAST_MERCHANT_ID
#   firebase functions:secrets:set PAYFAST_MERCHANT_KEY
#   firebase functions:secrets:set PAYFAST_PASSPHRASE
#   firebase functions:secrets:set PAYFAST_ENV         (values: "sandbox" or "production")
#   firebase functions:secrets:set SITE_DOMAIN          (e.g. "profusebeauty.co.za")
#   firebase functions:secrets:set DEEPSEEK_API_KEY
