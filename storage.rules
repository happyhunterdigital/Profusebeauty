rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Root level fallback lockdown
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Scoped avatar upload locks
    match /users/{userId}/avatars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                    && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)'); // Exact safe visual MIME formats
    }
  }
}
