rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Customer accounts
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Public product catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Public blog / journal
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Secured order submissions
    function isValidOrderData() {
      return request.resource.data.keys().hasAll(['amount', 'itemName', 'affiliateCode', 'status'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000
        && request.resource.data.itemName is string
        && request.resource.data.status in ['PENDING', 'PAID', 'Processing', 'Shipped', 'Delivered']
        && (request.resource.data.userId == null || request.resource.data.userId == request.auth.uid)
        && request.resource.data.keys().size() <= 20;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null && isValidOrderData();
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      // Only admin can transition status or modify after create
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    function isValidBookingData() {
      return request.resource.data.keys().hasAll(['fullName', 'phone', 'location', 'time'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20
        && request.resource.data.location is string
        && request.resource.data.time is string
        && request.resource.data.keys().size() <= 20;
    }

    function isValidMailData() {
      return request.resource.data.keys().hasAll(['to', 'message'])
        && request.resource.data.to is string
        && request.resource.data.to.lower().matches('.*@.*[.].*')
        && request.resource.data.to.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 10000
        && request.resource.data.keys().size() <= 10;
    }

    // Rate-limit bookings: only allow 3 writes per unique document prefix per hour
    function isNotRateLimited() {
      return !request.time || (
        getAfter(
          /databases/$(database)/documents/bookings/$(request.resource.id)
        ).data.createdAt == request.time
      );
    }

    // Shade-match bookings — public create (unauthenticated), admin-only read/manage
    match /bookings/{bookingId} {
      allow create: if isValidBookingData();
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Shade Matching Event bookings (landing page)
    match /shadeMatchingBookings/{bookingId} {
      allow create: if isValidBookingData();
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Firebase "Trigger Email from Firestore" extension collection
    // Public create so the booking form can queue emails without auth
    match /mail/{mailId} {
      allow create: if isValidMailData() && request.resource.data.keys().size() <= 10;
      allow read, update, delete: if false;
    }

    // Affiliate system — pending applications
    // Public can submit an application to join
    match /affiliates/{affiliateId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*[.].*')
        && request.resource.data.keys().size() <= 15;
      // Affiliate can VIEW own record (after approval, Claimed by Cloud Functions)
      allow read: if
        request.auth != null &&
        (request.auth.token.admin == true ||
         resource.data.email == request.auth.token.email);
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Click logs — public can write (tracking works without auth since cookies/session)
    // Admin-only read — don't expose raw click logs publicly
    match /affiliate_clicks/{clickId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Commission sales — created server-side by authenticated functions only
    // Public can't fake sales; backend affilite_verification Cloud Function handles this
    match /affiliate_sales/{saleId} {
      allow create: if request.auth != null && request.auth.token.admin == true;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Payout requests — public can request, admin-only read/manage
    match /affiliate_payouts/{payoutId} {
      allow create: if
        request.resource.data.keys().hasAll(['affiliateId', 'amount'])
        && request.resource.data.affiliateId is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 50000
        && (request.resource.data.status == null || request.resource.data.status == 'requested')
        && request.resource.data.keys().size() <= 8;
      allow read: if
        request.auth != null &&
        (request.auth.token.admin == true ||
         get(/databases/$(database)/documents/affiliates/$(resource.data.affiliateId)).data.email == request.auth.token.email);
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
