rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Customer accounts
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Public product catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Public blog / journal
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Secured order submissions
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
    }

    function isValidBookingData() {
      return request.resource.data.keys().hasAll(['fullName', 'phone', 'location', 'time'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20
        && request.resource.data.location is string
        && request.resource.data.time is string;
    }

    function isValidMailData() {
      return request.resource.data.keys().hasAll(['to', 'message'])
        && request.resource.data.to is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 10000;
    }

    // Shade-match bookings — public create (unauthenticated), admin-only read/manage
    match /bookings/{bookingId} {
      allow create: if isValidBookingData();
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Shade Matching Event bookings (landing page)
    match /shadeMatchingBookings/{bookingId} {
      allow create: if isValidBookingData();
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Firebase "Trigger Email from Firestore" extension collection
    // Public create so the booking form can queue emails without auth
    match /mail/{mailId} {
      allow create: if isValidMailData() && request.resource.data.keys().size() <= 10;
      allow read, update, delete: if false;
    }
  }
}
